+++ b/frontend/src/pages/economia/economyUtils.test.js
@@ -0,0 +1,17 @@
+import { describe, expect, it } from 'vitest'
+import { buildRefundPath, formatBs } from './economyUtils'
+
+describe('Representación económica', () => {
+  it('distingue un saldo no comparable de un cero real', () => {
+    expect(formatBs(null)).not.toBe('Bs 0.00')
+    expect(formatBs(undefined)).not.toBe('Bs 0.00')
+    expect(formatBs(0)).toBe('Bs 0.00')
+    expect(formatBs(400)).toBe('Bs 400.00')
+  })
+  it('el enlace de devolución no solicita anular el origen', () => {
+    const url = new URL(buildRefundPath({ originType: 'PAGO_PEDIDO', originId: 5, targetState: 'ANULADA', returnTo: '/app/pedidos/pagos' }), 'http://localhost')
+    expect(url.searchParams.get('origin_id')).toBe('5')
+    expect(url.searchParams.has('target_status')).toBe(false)
+    expect(url.searchParams.get('return_to')).toBe('/app/pedidos/pagos')
+  })
+})
diff --git a/frontend/src/pages/economia/GuaranteeMovementDrawer.jsx b/frontend/src/pages/economia/GuaranteeMovementDrawer.jsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/pages/economia/GuaranteeMovementDrawer.jsx
@@ -0,0 +1,73 @@
+/* eslint-disable react/prop-types */
+import { Alert, App, Button, Descriptions, Drawer, Form, Input, InputNumber, Select } from 'antd'
+import { useEffect, useRef, useState } from 'react'
+
+import { apiClient } from '../../api/client'
+import { FORM_COMMON_PROPS } from '../../components/forms/formConfig'
+import { FormProcessAlert } from '../../components/forms/FormProcessAlert'
+import { applyFormApiError } from '../../components/forms/formErrorUtils'
+import { formatBs } from './economyUtils'
+
+const METHODS = [
+  { value: 'efectivo', label: 'EFECTIVO' }, { value: 'qr', label: 'QR' },
+  { value: 'transaccion', label: 'TRANSFERENCIA' }, { value: 'tarjeta', label: 'TARJETA' },
+  { value: 'ticket_o_vale', label: 'TICKET O VALE' },
+]
+
+export function GuaranteeMovementDrawer({ outputId, isAdmin, onClose, onSaved }) {
+  const [form] = Form.useForm()
+  const { message } = App.useApp()
+  const [balance, setBalance] = useState(null)
+  const [error, setError] = useState(null)
+  const [saving, setSaving] = useState(false)
+  const pending = useRef(false)
+  useEffect(() => {
+    setBalance(null)
+    setError(null)
+    form.resetFields()
+    if (!outputId) return
+    const controller = new AbortController()
+    apiClient.get(`/economia/garantias/${outputId}`, { signal: controller.signal })
+      .then(({ data }) => { if (!controller.signal.aborted) setBalance(data) })
+      .catch((failure) => { if (!controller.signal.aborted) setError(failure.response?.data?.detail || 'NO FUE POSIBLE LEER LA CUSTODIA.') })
+    return () => controller.abort()
+  }, [outputId, form])
+
+  const submit = async (values) => {
+    if (pending.current) return
+    pending.current = true
+    setSaving(true)
+    setError(null)
+    try {
+      await apiClient.post(`/economia/garantias/${outputId}/movimientos`, values)
+      message.success('MOVIMIENTO DE CUSTODIA REGISTRADO. NO ES INGRESO COMERCIAL.')
+      onClose()
+      onSaved?.()
+    } catch (failure) {
+      setError(applyFormApiError(form, failure, { fallbackGlobalMessage: 'NO FUE POSIBLE REGISTRAR EL MOVIMIENTO.' }).globalMessage)
+    } finally {
+      pending.current = false
+      setSaving(false)
+    }
+  }
+
+  return <Drawer title={`Custodia de garantía — salida #${outputId || ''}`} width={640} open={Boolean(outputId)} onClose={() => { if (!saving) onClose() }} maskClosable={false}>
+    <Alert type="info" showIcon message="DINERO EN CUSTODIA, SEPARADO DEL COBRO DEL FLETE" description="La devolución física del vestido no paga la garantía. Una retención requiere autorización del administrador y queda pendiente de liquidación." style={{ marginBottom: 16 }} />
+    <FormProcessAlert message={error} />
+    {balance ? <Descriptions bordered column={1} size="small" style={{ marginBottom: 16 }}>
+      <Descriptions.Item label="RECIBIDO">{formatBs(balance.received_bob)}</Descriptions.Item>
+      <Descriptions.Item label="DEVUELTO">{formatBs(balance.returned_bob)}</Descriptions.Item>
+      <Descriptions.Item label="RETENIDO PENDIENTE">{formatBs(balance.retained_pending_bob)}</Descriptions.Item>
+      <Descriptions.Item label="DISPONIBLE PARA DEVOLVER">{formatBs(balance.available_return_bob)}</Descriptions.Item>
+    </Descriptions> : null}
+    <Form {...FORM_COMMON_PROPS} form={form} onFinish={submit}>
+      <Form.Item name="action" label="MOVIMIENTO REAL" rules={[{ required: true }]}>
+        <Select options={[{ value: 'RECEIVE', label: 'RECIBIR GARANTÍA' }, { value: 'RETURN', label: 'DEVOLVER GARANTÍA' }, ...(isAdmin ? [{ value: 'RETAIN', label: 'AUTORIZAR RETENCIÓN PENDIENTE' }] : [])]} />
+      </Form.Item>
+      <Form.Item name="amount" label="MONTO (BOB)" rules={[{ required: true }]}><InputNumber min={0.01} precision={2} style={{ width: '100%' }} /></Form.Item>
+      <Form.Item name="payment_method" label="MÉTODO REAL" rules={[{ required: true }]}><Select options={METHODS} /></Form.Item>
+      <Form.Item name="reason" label="MOTIVO / AUTORIZACIÓN" rules={[{ required: true }, { min: 5 }]}><Input.TextArea rows={3} maxLength={300} /></Form.Item>
+      <Button type="primary" htmlType="submit" loading={saving} disabled={!balance}>REGISTRAR MOVIMIENTO</Button>
+    </Form>
+  </Drawer>
+}
diff --git a/frontend/src/pages/economia/RefundReceiptDocument.jsx b/frontend/src/pages/economia/RefundReceiptDocument.jsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/pages/economia/RefundReceiptDocument.jsx
@@ -0,0 +1,43 @@
+/* eslint-disable react/prop-types */
+import { Button, Typography } from 'antd'
+import { renderToStaticMarkup } from 'react-dom/server'
+import { formatBs, incomeSourceLabel } from './economyUtils'
+
+export function RefundReceiptDocument({ document }) {
+  const snapshot = document.snapshot || {}
+  const content = <article aria-label="Constancia interna de devolución">
+      <h2>BELLAARTE BOUTIQUE</h2>
+      <h3>Constancia de devolución #{document.id}</h3>
+      <p><strong>DOCUMENTO INTERNO — NO FISCAL</strong></p>
+      <dl>
+        <dt>Fecha de emisión</dt><dd>{new Date(document.fecha).toLocaleString('es-BO', { timeZone: 'America/La_Paz' })}</dd>
+        <dt>Origen</dt><dd>{incomeSourceLabel(snapshot.origin_type)} #{snapshot.origin_id}</dd>
+        <dt>Comprobante original</dt><dd>{snapshot.original_receipt_id ? `#${snapshot.original_receipt_id}` : 'SIN REFERENCIA'}</dd>
+        <dt>Egreso</dt><dd>#{snapshot.expense_id}</dd>
+        <dt>Importe devuelto</dt><dd>{formatBs(snapshot.amount_bob)}</dd>
+        <dt>Método real de devolución</dt><dd>{snapshot.payment_method === 'transaccion' ? 'TRANSFERENCIA' : snapshot.payment_method?.toUpperCase()}</dd>
+        <dt>Responsable</dt><dd>{snapshot.responsible} (#{snapshot.responsible_id})</dd>
+        <dt>Beneficiario</dt><dd>{snapshot.beneficiary || 'SIN REGISTRO'}</dd>
+        <dt>Motivo</dt><dd style={{ whiteSpace: 'pre-wrap' }}>{snapshot.reason}</dd>
+        <dt>Total devuelto a la fecha de emisión</dt><dd>{formatBs(snapshot.refunded_total_bob)}</dd>
+        <dt>Saldo reembolsable a la fecha de emisión</dt><dd>{formatBs(snapshot.refundable_balance_bob)}</dd>
+      </dl>
+      <p>Esta constancia conserva los datos de su emisión. La devolución de dinero es independiente del estado operativo y no modifica el comprobante original.</p>
+    </article>
+
+  const print = () => {
+    const popup = window.open('', '_blank')
+    if (!popup) return
+    popup.opener = null
+    // Snapshot values only enter the document through React's text escaping.
+    popup.document.write(`<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Constancia de devolución</title><style>body{font:14px Arial,sans-serif;margin:32px;color:#111}dt{font-weight:bold;margin-top:12px}dd{margin:4px 0;overflow-wrap:anywhere}@page{margin:16mm}</style></head><body>${renderToStaticMarkup(content)}</body></html>`)
+    popup.document.close()
+    popup.focus()
+    popup.print()
+  }
+  return <>
+    {content}
+    <Typography.Paragraph type="secondary">Si el navegador bloquea la ventana, habilita las ventanas emergentes para imprimir esta constancia.</Typography.Paragraph>
+    <Button onClick={print}>IMPRIMIR CONSTANCIA</Button>
+  </>
+}
