# =========================
# Seguridad / secretos
# =========================
**/.env
**/.env.*
!**/.env.example

# Credenciales / llaves / certificados
**/*.pem
**/*.key
**/*.crt
**/*.pfx
**/*.p12
**/id_rsa*
**/id_ed25519*
**/credentials*.json
**/*service-account*.json

# Dumps / backups de base de datos
**/*.sql
**/*.dump
**/*.backup
**/*.bak
**/*.sqlite*
**/*.pgpass

# Node (por seguridad, evita subir node_modules en cualquier carpeta)
**/node_modules/
**/dist/
**/.vite/

# Python caches / cobertura
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Temporales comunes
*.tmp
*.swp
*.swo