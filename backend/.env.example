DATABASE_URL=postgresql://postgres:admin@localhost:5432/bellaarte_db
JWT_SECRET_KEY=change-me-access-token-secret
JWT_REFRESH_SECRET_KEY=change-me-refresh-token-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin12345!
BOOTSTRAP_ADMIN_EMAIL=admin@bellaarte.local
BOOTSTRAP_ADMIN_NAMES=ADMIN
BOOTSTRAP_ADMIN_LAST_NAME=BELLAARTE
BOOTSTRAP_ADMIN_MOTHER_LAST_NAME=SISTEMA
BOOTSTRAP_ADMIN_CI=1000000
BOOTSTRAP_ADMIN_CELLPHONE=70000000
BOOTSTRAP_ADMIN_ZONE=CENTRAL
BOOTSTRAP_ADMIN_ADDRESS=OFICINA PRINCIPAL
BOOTSTRAP_ADMIN2_USERNAME=admin2
BOOTSTRAP_ADMIN2_PASSWORD=Admin22345!
BOOTSTRAP_ADMIN2_EMAIL=admin2@bellaarte.local
BOOTSTRAP_ADMIN2_NAMES=ADMIN DOS
BOOTSTRAP_ADMIN2_LAST_NAME=BELLAARTE
BOOTSTRAP_ADMIN2_MOTHER_LAST_NAME=SISTEMA
BOOTSTRAP_ADMIN2_CI=1000001
BOOTSTRAP_ADMIN2_CELLPHONE=70000001
BOOTSTRAP_ADMIN2_ZONE=CENTRAL
BOOTSTRAP_ADMIN2_ADDRESS=OFICINA PRINCIPAL

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion

BACKUP_DIR=./storage/backups
PG_DUMP_PATH=
BACKUP_TIMEZONE=America/La_Paz
BACKUP_FILENAME_PREFIX=bellaarte_backup

# LENY: Ollama local, sin servicios cloud ni herramientas empresariales
LENY_ENABLED=true
LENY_OLLAMA_URL=http://127.0.0.1:11434
LENY_MODEL=qwen3.5:4b-q4_K_M
LENY_NUM_CTX=4096
LENY_NUM_PREDICT=768
LENY_TEMPERATURE=0.3
LENY_KEEP_ALIVE=5m
LENY_CONNECT_TIMEOUT=5
LENY_FIRST_TOKEN_TIMEOUT=90
LENY_IDLE_TIMEOUT=30
LENY_TOTAL_TIMEOUT=120
LENY_MAX_MESSAGE_CHARS=2000
LENY_MAX_BODY_BYTES=16384
LENY_MAX_RESPONSE_BYTES=32768
# 0: no purgar. Un valor positivo requiere ejecutar mantenimiento explícito.
LENY_RETENTION_DAYS=0
# Etapa 01.1: cuota rolling compartida por persona y revisión de fragmentos.
LENY_RATE_LIMIT=5
LENY_RATE_WINDOW_SECONDS=60
LENY_OUTPUT_HOLDBACK_CHARS=256
LENY_CLASSIFIER_TIMEOUT=20

# RAG-SPEC-01: biblioteca ADMIN. Activar sólo después del despliegue autorizado
# de 0019, validadores instalados y raíz privada fuera de Laragon/www.
LENY_DOCUMENTS_ENABLED=false
# Vacío: %LOCALAPPDATA%/BAB_VDOS/leny-documents (cuenta Windows del backend).
LENY_DOCUMENTS_ROOT=
LENY_DOCUMENTS_MAX_BODY_BYTES=12582912
LENY_DOCUMENTS_MAX_FILE_BYTES=10485760
LENY_DOCUMENTS_IMAGE_BYTES=5242880
LENY_DOCUMENTS_MAX_PIXELS=12000000
LENY_DOCUMENTS_PDF_PAGES=50
LENY_DOCUMENTS_ZIP_ENTRIES=1000
LENY_DOCUMENTS_ZIP_BYTES=33554432
LENY_DOCUMENTS_ZIP_ENTRY_BYTES=8388608
LENY_DOCUMENTS_ZIP_RATIO=100
LENY_DOCUMENTS_VALIDATION_SECONDS=30
LENY_DOCUMENTS_VALIDATION_MEMORY_MB=768
LENY_DOCUMENTS_UPLOAD_SECONDS=180
LENY_DOCUMENTS_IDLE_SECONDS=30
LENY_DOCUMENTS_CAPACITY_BYTES=5368709120
LENY_DOCUMENTS_MIN_FREE_BYTES=1073741824
LENY_DOCUMENTS_MAX_FOLDERS=1000
LENY_DOCUMENTS_MAX_DEPTH=8
LENY_DOCUMENTS_BATCH_SIZE=5
LENY_DOCUMENTS_MAX_DOCUMENTS=10000
LENY_DOCUMENTS_MAX_VERSIONS=100
LENY_DOCUMENTS_MAX_TOTAL_VERSIONS=100000
LENY_DOCUMENTS_RATE_LIMIT=5
LENY_DOCUMENTS_RATE_WINDOW_SECONDS=60
LENY_DOCUMENTS_RETENTION_DAYS=10
LENY_DOCUMENTS_MAINTENANCE_SECONDS=900

# SPEC-02. Enable only after native tools, vector extension and migration0020.
# Uvicorn administra el worker y, si hace falta, Ollama local. Los modelos se
# cargan bajo demanda; una instancia Ollama preexistente no se cierra.
LENY_RUNTIME_AUTOSTART=true
# Opcional: ruta absoluta del ollama.exe instalado cuando no esté en PATH.
# LENY_OLLAMA_EXECUTABLE=C:/Users/USUARIO/AppData/Local/Programs/Ollama/ollama.exe
LENY_RUNTIME_STARTUP_SECONDS=20
LENY_RUNTIME_SHUTDOWN_SECONDS=240
LENY_RAG_ENABLED=false
LENY_RAG_MODEL=qwen3-embedding:0.6b
LENY_RAG_MODEL_DIGEST=ac6da0dfba84a81fdbfbaf330198c33cd77c4cdfc53e8bc50eb581914a15621d
# Private runtime defaults: LOCALAPPDATA/BAB_VDOS/leny-rag-runtime/{tesseract,tessdata}
# LENY_RAG_TESSERACT_PATH=C:/private/runtime/tesseract/tesseract.exe
# LENY_RAG_TESSDATA_PATH=C:/private/runtime/tessdata
LENY_RAG_CPU_THREADS=4
LENY_RAG_BATCH_SIZE=2
LENY_RAG_NUM_CTX=4096
LENY_RAG_CONNECT_SECONDS=5
LENY_RAG_READ_SECONDS=120
LENY_RAG_BATCH_SECONDS=150
LENY_RAG_JOB_SECONDS=1800
LENY_RAG_MAX_ATTEMPTS=3
LENY_RAG_HEARTBEAT_SECONDS=5
LENY_RAG_LEASE_SECONDS=60
LENY_RAG_POLL_SECONDS=2
LENY_RAG_RATE_LIMIT=5
LENY_RAG_QUEUE_LIMIT=100
LENY_RAG_MAX_TEXT_BYTES=1048576
LENY_RAG_MAX_CHUNKS=1000
LENY_RAG_MAX_TOTAL_CHUNKS=100000
LENY_RAG_CAPACITY_BYTES=2147483648
LENY_RAG_CHUNK_TARGET=1600
LENY_RAG_CHUNK_CHARS=2000
LENY_RAG_CHUNK_BYTES=3072
LENY_RAG_OVERLAP_CHARS=240
LENY_RAG_OCR_PAGES=20
LENY_RAG_OCR_DPI=200
LENY_RAG_RENDER_PIXELS=12000000
LENY_RAG_OCR_SECONDS=30
LENY_RAG_PARSER_MEMORY_MB=1536
LENY_RAG_TEMP_BYTES=268435456
LENY_RAG_MIN_FREE_BYTES=2147483648
LENY_RAG_MIN_RAM_BYTES=2147483648
LENY_RAG_MIN_RESIDENT_RAM_BYTES=1073741824
LENY_RAG_STAGING_RETENTION_DAYS=7

# SPEC-03: requires migration0021 and separate activation; never enables itself.
LENY_RAG_CHAT_ENABLED=false
LENY_RAG_TOP_K=5
LENY_RAG_CANDIDATES=20
LENY_RAG_MAX_CONTEXT_BYTES=2048
LENY_RAG_QUERY_MAX_BYTES=1536
LENY_RAG_SEARCH_TIMEOUT_SECONDS=2
LENY_RAG_QUERY_EMBED_TIMEOUT_SECONDS=20
LENY_RAG_ALLOW_SOURCE_DOWNLOAD=true

# SPEC-04: keep legacy until isolated and specifically authorized business E2E pass.
# Rollback changes the profile only; no database migration or reindex is needed.
LENY_RAG_PROFILE=legacy
LENY_RAG_EVIDENCE_MODE=fixed
# Experimental cold one-token probes, at most3; requires keep_alive=0.
# Falls back to conservative packing unless repeated cold counts agree.
LENY_RAG_ADAPTIVE_TOKEN_PROBE=false
# Fixed experiment caps: 2048 / 2304 / 2560; adaptive uses conservative remaining context.
# Context4096, output768, margin256, CPU/RAM/quotas stay unchanged.
LENY_RAG_RANKING=semantic
LENY_RAG_NEIGHBOR_CHUNKS=false
