-- =========================================================
-- BASE DE DATOS V.0.1 - BELLAARTE BOUTIQUE
-- PostgreSQL 17
-- Diseño simplificado
-- =========================================================


-- =========================================================
-- TABLA: ROL
-- =========================================================
CREATE TABLE ROL (
    ROL_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    ROL_NOM             VARCHAR(50) NOT NULL UNIQUE,
    ROL_DES             VARCHAR(150),
    ROL_HAB             BOOLEAN NOT NULL DEFAULT TRUE,
    ROL_FEC_REG         TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);


-- =========================================================
-- TABLA: USUARIO
-- =========================================================
CREATE TABLE USUARIO (
    USU_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    USU_NOM             VARCHAR(100) NOT NULL,
    USU_APE_PAT         VARCHAR(100) NOT NULL,
    USU_APE_MAT         VARCHAR(100),
    USU_CEL             VARCHAR(30),
    USU_CI              VARCHAR(30),
    USU_COR             VARCHAR(120),
    USU_DIR             VARCHAR(200),
    USU_HAB             BOOLEAN NOT NULL DEFAULT TRUE,
    USU_FEC_REG         TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);


-- =========================================================
-- TABLA: CUENTA
-- =========================================================
CREATE TABLE CUENTA (
    CUE_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    USU_ID              BIGINT NOT NULL,
    ROL_ID              BIGINT NOT NULL,
    CUE_NOM_USU         VARCHAR(50) NOT NULL UNIQUE,
    CUE_CON             TEXT NOT NULL,
    CUE_HAB             BOOLEAN NOT NULL DEFAULT TRUE,
    CUE_FEC_CRE         TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CUE_ULT_ACC         TIMESTAMP,

    CONSTRAINT FK_CUE_USU
        FOREIGN KEY (USU_ID)
        REFERENCES USUARIO (USU_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_CUE_ROL
        FOREIGN KEY (ROL_ID)
        REFERENCES ROL (ROL_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

-- =========================================================
-- TABLA: CLIENTE
-- =========================================================
CREATE TABLE CLIENTE (
    CLI_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    CLI_COD             VARCHAR(20) NOT NULL UNIQUE,
    CLI_NOM             VARCHAR(100) NOT NULL,
    CLI_APE_PAT         VARCHAR(100) NOT NULL,
    CLI_APE_MAT         VARCHAR(100),
    CLI_CEL             VARCHAR(30) NOT NULL,
    CLI_CEL_REF         VARCHAR(30),
    CLI_NOM_CEL_REF     VARCHAR(120),
    CLI_COR             VARCHAR(120),
    CLI_CI              VARCHAR(30),
    CLI_NAC             VARCHAR(100),
    CLI_ZONA            VARCHAR(100),
    CLI_CALLE           VARCHAR(100),
    CLI_OBS             TEXT,
    CLI_HAB             BOOLEAN NOT NULL DEFAULT TRUE,
    CLI_FEC_REG         TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- =========================================================
-- TABLA: INVENTARIO_BOUTIQUE
-- =========================================================
CREATE TYPE TIPO_INVENTARIO_BOUTIQUE AS ENUM (
    'BANDEJA',
    'BOUQUET',
    'BRASIER',
    'CADENA',
    'CANASTA',
    'CINTURON DE PIEDRAS',
    'COLLAR',
    'COPAS NOVIOS',
    'CORONA',
    'FUSTE DE CABLES',
    'FUSTE DE CAN CAN',
    'GUANTES',
    'JUEGO DE BISUTERIA',
    'LAZO MATRIMONIAL',
    'LIGUERO',
    'MONEDAS',
    'PORTA AROS',
    'PULSERA',
    'TAPETE',
    'TARJETA'
    'VELO',
    'VESTIDO DE 15 AÑOS',
    'VESTIDO DE CIVIL',
    'VESTIDO DE FIESTA',
    'VESTIDO DE NOVIA',
    'VESTIDO OTRO',
    'OTRO'
);

CREATE TYPE TIPO_TAMANO_BOUTIQUE AS ENUM (
    'PEQUEÑO',
    'MEDIANO',
    'GRANDE'
);

CREATE TYPE COPA_TALLA_BOUTIQUE AS ENUM (
    'COPA AA',
    'COPA A',
    'COPA B',
    'COPA C',
    'COPA D',
    'COPA DD',
    'COPA E',
    'COPA F',
    'COPA G'
);

CREATE TYPE TALLA_BOUTIQUE AS ENUM (
    'TALLA XXS',
    'TALLA XS',
    'TALLA S',
    'TALLA M',
    'TALLA L',
    'TALLA XL',
    'TALLA XXL',
    'TALLA XXXL'
);

CREATE TABLE INVENTARIO_BOUTIQUE (
    INB_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    INB_COD             VARCHAR(40) NOT NULL UNIQUE,
    INB_TIPO            TIPO_INVENTARIO_BOUTIQUE NOT NULL,
    INB_DES             TEXT,
    INB_COLOR           VARCHAR(50) NOT NULL,
    INB_FORMA           VARCHAR(50),
    INB_TAMANO          TIPO_TAMANO_BOUTIQUE,
    INB_COPA_TALLA      COPA_TALLA_BOUTIQUE,
    INB_TALLA           TALLA_BOUTIQUE,
    INB_MATERIAL        VARCHAR(80),
    INB_MEDIDAS         TEXT,
    INB_PROVEEDOR       VARCHAR(100),
    INB_PRECIO_COMPRA   NUMERIC(12,2) NOT NULL DEFAULT 0,
    INB_PRECIO_VENTA    NUMERIC(12,2) NOT NULL DEFAULT 0,
    INB_STOCK           NUMERIC(12,2) NOT NULL DEFAULT 0,
    INB_ESTADO          BOOLEAN NOT NULL DEFAULT TRUE,
    INB_OBS             TEXT,
    INB_FEC_REG         TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT CK_INB_PRECIO_COMPRA CHECK (INB_PRECIO_COMPRA >= 0),
    CONSTRAINT CK_INB_PRECIO_VENTA CHECK (INB_PRECIO_VENTA >= 0),
    CONSTRAINT CK_INB_STOCK CHECK (INB_STOCK >= 0)
);

-- =========================================================
-- TABLA: VENTA_BOUTIQUE
-- =========================================================

CREATE TYPE MOTIVO_DESC_VENTA_BOUTIQUE AS ENUM (
    'REBAJA',
    'PROMOCION'
);

CREATE TYPE METODO_PAGO_VENTA_BOUTIQUE AS ENUM (
    'EFECTIVO',
    'QR',
    'TRANSACCION',
    'TICKET O VALE'
);

CREATE TYPE ESTADO_VENTA_BOUTIQUE AS ENUM (
    'ACTIVA',
    'CANCELADA',
    'ANULADA'
);

CREATE TABLE VENTA_BOUTIQUE (
    VEB_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    INB_ID              BIGINT NOT NULL,
    USU_ID              BIGINT NOT NULL,
    CLI_ID              BIGINT,
    VEB_FEC             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    VEB_CAN             NUMERIC(12,2) NOT NULL,
    VEB_PRE_UNI         NUMERIC(12,2) NOT NULL,
    VEB_DESCUENTO       NUMERIC(12,2),
    VEB_MOTIVO_DESC     MOTIVO_DESC_VENTA_BOUTIQUE, 
    VEB_TOT             NUMERIC(12,2) NOT NULL,
    VEB_METODO_PAGO     METODO_PAGO_VENTA_BOUTIQUE NOT NULL,
    VEB_OBS             TEXT,
    VEB_ESTADO          ESTADO_VENTA_BOUTIQUE NOT NULL DEFAULT 'ACTIVA',

    CONSTRAINT FK_VEB_INB
        FOREIGN KEY (INB_ID)
        REFERENCES INVENTARIO_BOUTIQUE (INB_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_VEB_USU
        FOREIGN KEY (USU_ID)
        REFERENCES USUARIO (USU_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_VEB_CLI
        FOREIGN KEY (CLI_ID)
        REFERENCES CLIENTE (CLI_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT CK_VEB_CAN CHECK (VEB_CAN > 0),
    CONSTRAINT CK_VEB_PRE_UNI CHECK (VEB_PRE_UNI >= 0),
    CONSTRAINT CK_VEB_TOT CHECK (VEB_TOT >= 0),
    CONSTRAINT CK_VEB_DESCUENTO CHECK (VEB_DESCUENTO IS NULL OR VEB_DESCUENTO >= 0),
    CONSTRAINT CK_VEB_DESC_MOTIVO
    CHECK (
        (VEB_DESCUENTO IS NULL AND VEB_MOTIVO_DESC IS NULL)
        OR
        (VEB_DESCUENTO IS NOT NULL AND VEB_MOTIVO_DESC IS NOT NULL)
    )
);

-- =========================================================
-- TABLA: INVENTARIO_TALLER
-- =========================================================

CREATE TYPE TIPO_INVENTARIO_TALLER AS ENUM (
    'TELA',
    'GUIPUR',
    'ONDA',
    'HILO',
    'BOLSAS DE ENTREGA'
    'ALFILERES',
    'VARILLA'
    'BOTONES',
    'PEDRERÍA',
    'CIERRES',
    'PVC',
    'OTRO'
);

CREATE TYPE UNIDAD_MEDIDA_TALLER AS ENUM (
    'METRO',
    'CENTIMETRO',
    'ROLLO',
    'CAJA',
    'KILOGRAMO',
    'GRAMO',
    'YARDA',
    'RANDA',
    'UNIDAD',
    'OTRO'
);

CREATE TYPE TIPO_TAMANO_TALLER AS ENUM (
    'PEQUEÑO',
    'MEDIANO',
    'GRANDE'
);

CREATE TABLE INVENTARIO_TALLER (
    INT_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    INT_COD             VARCHAR(40) NOT NULL UNIQUE,
    INT_NOM             VARCHAR(120) NOT NULL,
    INT_TIPO            TIPO_INVENTARIO_TALLER NOT NULL,
    INT_DES1            TEXT,
    INT_DES2            TEXT,
    INT_COLOR           VARCHAR(50),
    INT_TAMANO          TIPO_TAMANO_TALLER,
    INT_MATERIAL        VARCHAR(80),
    INT_PROVEEDOR       VARCHAR(100),
    INT_COSTO_REF       NUMERIC(12,2) NOT NULL DEFAULT 0,
    INT_STOCK           NUMERIC(12,2) NOT NULL DEFAULT 0,
    INT_UNI_MED         UNIDAD_MEDIDA_TALLER NOT NULL,
    INT_STOCK_MIN       NUMERIC(12,2) NOT NULL DEFAULT 0,
    INT_ESTADO          BOOLEAN NOT NULL DEFAULT TRUE,
    INT_OBS             TEXT,
    INT_FEC_REG         TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT CK_INT_COSTO_REF CHECK (INT_COSTO_REF >= 0),
    CONSTRAINT CK_INT_STOCK CHECK (INT_STOCK >= 0),
    CONSTRAINT CK_INT_STOCK_MIN CHECK (INT_STOCK_MIN >= 0)
);

-- =========================================================
-- TABLA: SALIDA_MATERIAL_TALLER
-- =========================================================

CREATE TYPE UNIDAD_MEDIDA_SALIDA_TALLER AS ENUM (
    'METRO',
    'CENTIMETRO',
    'ROLLO',
    'CAJA',
    'KILOGRAMO',
    'GRAMO',
    'YARDA',
    'RANDA',
    'UNIDAD',
    'OTRO'
);

CREATE TABLE SALIDA_MATERIAL_TALLER (
    SMT_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    INT_ID              BIGINT NOT NULL, 
    USU_ID              BIGINT,
    SMT_FEC             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    SMT_CAN             NUMERIC(12,2) NOT NULL,
    SMT_UNI_MED         UNIDAD_MEDIDA_SALIDA_TALLER NOT NULL,
    SMT_DESTINO         VARCHAR(150) NOT NULL, 
    SMT_OBS1            TEXT, 
    SMT_OBS2            TEXT,
    SMT_ESTADO          BOOLEAN NOT NULL DEFAULT TRUE,

    CONSTRAINT FK_SMT_INT
        FOREIGN KEY (INT_ID)
        REFERENCES INVENTARIO_TALLER (INT_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_SMT_USU
        FOREIGN KEY (USU_ID)
        REFERENCES USUARIO (USU_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT CK_SMT_CAN CHECK (SMT_CAN > 0)
);

-- =========================================================
-- TABLA: PEDIDO
-- Simplificada:
-- - datos del vestido/pedido
-- - medidas
-- - 4 pruebas
-- - estado del vestido por prueba
-- - total, pagado y saldo
-- =========================================================

CREATE TYPE TIPO_PEDIDO AS ENUM (
    'CONFECCION NOVIA',
    'CONFECCION 15 AÑOS',
    'CONEFCCIÓN CIVIL',
    'CONFECCIÓN FIESTA',
    'CONFECCIÓN NIÑA',
    'FLETE 15 AÑOS',
    'VELO',
    'COLA',
    'BOUQUET',
    'DAMAS',
    'OTRO'
);

CREATE TYPE PRU1_EST_PEDIDO AS ENUM (
    'LISTO',
    'EN PRODUCCIÓN',
    'ARREGLO TALLER',
    'DECORACIÓN TALLER',
    'DECORACIÓN EXTERNO',
    'COSTURERO EXTERNO',
    'OTRO'
);

CREATE TYPE PRU2_EST_PEDIDO AS ENUM (
    'LISTO',
    'EN PRODUCCIÓN',
    'ARREGLO TALLER',
    'DECORACIÓN TALLER',
    'DECORACIÓN EXTERNO',
    'COSTURERO EXTERNO',
    'OTRO'
);

CREATE TYPE PRU3_EST_PEDIDO AS ENUM (
    'LISTO',
    'EN PRODUCCIÓN',
    'ARREGLO TALLER',
    'DECORACIÓN TALLER',
    'DECORACIÓN EXTERNO',
    'COSTURERO EXTERNO',
    'OTRO'
);

CREATE TYPE PRU4_EST_PEDIDO AS ENUM (
    'LISTO',
    'EN PRODUCCIÓN',
    'ARREGLO TALLER',
    'DECORACIÓN TALLER',
    'DECORACIÓN EXTERNO',
    'COSTURERO EXTERNO',
    'OTRO'
);

CREATE TYPE PRU5_EST_PEDIDO AS ENUM (
    'LISTO',
    'EN PRODUCCIÓN',
    'ARREGLO TALLER',
    'DECORACIÓN TALLER',
    'DECORACIÓN EXTERNO',
    'COSTURERO EXTERNO',
    'OTRO'
);

CREATE TYPE MOTIVO_DESCUENTO_PEDIDO AS ENUM (
    'REBAJA',
    'PROMOCION'
);

CREATE TYPE ESTADO_PEDIDO_GENERAL AS ENUM (
    'ACTIVO',
    'ENTREGADO',
    'CANCELADO'
);

CREATE TABLE PEDIDO (
    PED_ID                      BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    CLI_ID                      BIGINT NOT NULL,
    PED_COD                     VARCHAR(30) NOT NULL UNIQUE,
    PED_TIPO                    TIPO_PEDIDO NOT NULL,
    PED_NOM_PEDIDO              VARCHAR(120) NOT NULL,
    PED_VIAJE                   BOOLEAN NOT NULL DEFAULT FALSE,
    PED_COLOR_PRIMERO           VARCHAR(50) NOT NULL,
    PED_COLOR_SEGUNDO           VARCHAR(50),
    PED_DESCRIPCION_MATERIAL    TEXT NOT NULL,
    PED_DESCRIPCION_DISEÑO      TEXT NOT NULL,
    PED_DESCRIPCION_3           TEXT,
    PED_FEC_REG_CONTRATO        TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PED_ENCARGADO_CONTRATO      VARCHAR(50),
    PED_FEC_DE_ENTRGA           DATE NOT NULL,
    PED_FEC_ENTREGA_FINAL       DATE,

    -- MEDIDAS_SOLO_PARA_VESTIDOS
    PED_ANE_ESP                 NUMERIC(6,2),
    PED_TAL_ESP                 NUMERIC(6,2),
    PED_TAL_DEL                 NUMERIC(6,2),
    PED_CON_CIN                 NUMERIC(6,2),
    PED_CON_CAD                 NUMERIC(6,2),
    PED_LAR_FAL                 NUMERIC(6,2),
    PED_SISA                    NUMERIC(6,2),
    PED_ANB_BUS                 NUMERIC(6,2),
    PED_SEP_BUS                 NUMERIC(6,2),
    PED_TAL_BUS                 NUMERIC(6,2),
    PED_TAL_COS                 NUMERIC(6,2),
    PED_LAR_MAN                 NUMERIC(6,2),
    PED_BRA                     NUMERIC(6,2),
    PED_PUN                     NUMERIC(6,2),

    -- PRUEBAS
    PED_PRU1_FEC                DATE,
    PED_PRU1_HOR                TIME,
    PED_PRU1_EST                PRU1_EST_PEDIDO,

    PED_PRU2_FEC                DATE,
    PED_PRU2_HOR                TIME,
    PED_PRU2_EST                PRU2_EST_PEDIDO,

    PED_PRU3_FEC                DATE,
    PED_PRU3_HOR                TIME,
    PED_PRU3_EST                PRU3_EST_PEDIDO,

    PED_PRU4_FEC                DATE,
    PED_PRU4_HOR                TIME,
    PED_PRU4_EST                PRU4_EST_PEDIDO,

    PED_PRU5_FEC                DATE,
    PED_PRU5_HOR                TIME,
    PED_PRU5_EST                PRU5_EST_PEDIDO,

    -- FINANZAS DEL PEDIDO
    PED_DESCUENTO               NUMERIC(12,2),
    PED_MOTIVO_DESCUENTO        MOTIVO_DESCUENTO_PEDIDO,
    PED_PRE_TOT                 NUMERIC(12,2) NOT NULL DEFAULT 0,
    PED_TOTAL_PAGADO            NUMERIC(12,2) NOT NULL DEFAULT 0,
    PED_SALDO                   NUMERIC(12,2) NOT NULL DEFAULT 0,

    PED_OBS                     TEXT,
    PED_ESTADO_GENERAL          ESTADO_PEDIDO_GENERAL NOT NULL DEFAULT 'ACTIVO',
    PED_HAB                     BOOLEAN NOT NULL DEFAULT TRUE,

    CONSTRAINT FK_PED_CLI
        FOREIGN KEY (CLI_ID)
        REFERENCES CLIENTE (CLI_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT CK_PED_PRE_TOT CHECK (PED_PRE_TOT >= 0),
    CONSTRAINT CK_PED_TOTAL_PAGADO CHECK (PED_TOTAL_PAGADO >= 0),
    CONSTRAINT CK_PED_SALDO CHECK (PED_SALDO >= 0),

    CONSTRAINT CK_PED_DESCUENTO CHECK (PED_DESCUENTO IS NULL OR PED_DESCUENTO >= 0),
    CONSTRAINT CK_PED_MOTIVO_DESCUENTO
    CHECK (
        (PED_DESCUENTO IS NULL AND PED_MOTIVO_DESCUENTO IS NULL)
        OR
        (PED_DESCUENTO IS NOT NULL AND PED_MOTIVO_DESCUENTO IS NOT NULL)
    ),


    CONSTRAINT CK_PED_ANE_ESP CHECK (PED_ANE_ESP IS NULL OR PED_ANE_ESP >= 0),
    CONSTRAINT CK_PED_TAL_ESP CHECK (PED_TAL_ESP IS NULL OR PED_TAL_ESP >= 0),
    CONSTRAINT CK_PED_TAL_DEL CHECK (PED_TAL_DEL IS NULL OR PED_TAL_DEL >= 0),
    CONSTRAINT CK_PED_CON_CIN CHECK (PED_CON_CIN IS NULL OR PED_CON_CIN >= 0),
    CONSTRAINT CK_PED_CON_CAD CHECK (PED_CON_CAD IS NULL OR PED_CON_CAD >= 0),
    CONSTRAINT CK_PED_LAR_FAL CHECK (PED_LAR_FAL IS NULL OR PED_LAR_FAL >= 0),
    CONSTRAINT CK_PED_SISA CHECK (PED_SISA IS NULL OR PED_SISA >= 0),
    CONSTRAINT CK_PED_ANB_BUS CHECK (PED_ANB_BUS IS NULL OR PED_ANB_BUS >= 0),
    CONSTRAINT CK_PED_SEP_BUS CHECK (PED_SEP_BUS IS NULL OR PED_SEP_BUS >= 0),
    CONSTRAINT CK_PED_TAL_BUS CHECK (PED_TAL_BUS IS NULL OR PED_TAL_BUS >= 0),
    CONSTRAINT CK_PED_TAL_COS CHECK (PED_TAL_COS IS NULL OR PED_TAL_COS >= 0),
    CONSTRAINT CK_PED_LAR_MAN CHECK (PED_LAR_MAN IS NULL OR PED_LAR_MAN >= 0),
    CONSTRAINT CK_PED_BRA CHECK (PED_BRA IS NULL OR PED_BRA >= 0),
    CONSTRAINT CK_PED_PUN CHECK (PED_PUN IS NULL OR PED_PUN >= 0)
);


-- =========================================================
-- TABLA: PAGO_PEDIDO
-- Cada registro representa un pago del pedido
-- =========================================================

CREATE TYPE METODO_PAGO_PEDIDO AS ENUM (
    'EFECTIVO',
    'QR',
    'TRANSACCION',
    'TICKET O VALE'
);

CREATE TABLE PAGO_PEDIDO (
    PPD_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    PED_ID              BIGINT NOT NULL,
    USU_ID              BIGINT,
    PPD_FEC             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PPD_MONTO           NUMERIC(12,2) NOT NULL,
    PPD_METODO          METODO_PAGO_PEDIDO NOT NULL,
    PPD_OBS1            TEXT,
    PPD_OBS2            TEXT,

    CONSTRAINT FK_PPD_PED
        FOREIGN KEY (PED_ID)
        REFERENCES PEDIDO (PED_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_PPD_USU
        FOREIGN KEY (USU_ID)
        REFERENCES USUARIO (USU_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT CK_PPD_MONTO CHECK (PPD_MONTO > 0)
);


-- =========================================================
-- TABLA: INGRESO
-- =========================================================

CREATE TYPE METODO_PAGO_INGRESO AS ENUM (
    'EFECTIVO',
    'QR',
    'TRANSACCION',
    'TICKET O VALE'
);

CREATE TYPE TIPO_INGRESO AS ENUM (
    'VENTA_BOUTIQUE',
    'PAGO_PEDIDO',
    'FLETE',
    'TICKET O VALE',
    'OTRO'
);

CREATE TABLE INGRESO (
    ING_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    PPD_ID              BIGINT,
    VEB_ID              BIGINT,
    USU_ID              BIGINT,
    ING_CONCEPTO        VARCHAR(150) NOT NULL,
    ING_FEC             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    ING_TIPO            TIPO_INGRESO NOT NULL,
    ING_MONTO           NUMERIC(12,2) NOT NULL,
    ING_METODO          METODO_PAGO_INGRESO NOT NULL,
    ING_OBS1            TEXT,
    ING_OBS2            TEXT,
    ING_ESTADO          BOOLEAN NOT NULL DEFAULT TRUE,

    CONSTRAINT FK_ING_USU
        FOREIGN KEY (USU_ID)
        REFERENCES USUARIO (USU_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_ING_PPD
        FOREIGN KEY (PPD_ID)
        REFERENCES PAGO_PEDIDO (PPD_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_ING_VEB
        FOREIGN KEY (VEB_ID)
        REFERENCES VENTA_BOUTIQUE (VEB_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT CK_ING_MONTO CHECK (ING_MONTO > 0),

     CONSTRAINT CK_ING_ORIGEN
        CHECK (
            (ING_TIPO = 'PAGO_PEDIDO' AND PPD_ID IS NOT NULL AND VEB_ID IS NULL)
            OR
            (ING_TIPO = 'VENTA_BOUTIQUE' AND VEB_ID IS NOT NULL AND PPD_ID IS NULL)
            OR
            (ING_TIPO IN ('FLETE', 'TICKET O VALE', 'OTRO') AND PPD_ID IS NULL AND VEB_ID IS NULL)
        )
);


-- =========================================================
-- TABLA: EGRESO
-- =========================================================

CREATE TYPE TIPO_EGRESO AS ENUM (
    'ALMUEZO',
    'ALQUILER',
    'COMIDA',
    'COSTURA',
    'DECORADO',
    'DEVOLUCIÓN',
    'INVENTARIO BOUTIQUE',
    'INVENTARIO TALLER',
    'MANTENIMIENTO',
    'MARKETING',
    'SERVICIO BÁSICO',
    'SUELDO',
    'TECNOLOGÍA',
    'OTRO'
);

CREATE TABLE EGRESO (
    EGR_ID              BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    USU_ID              BIGINT,
    EGR_FEC             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    EGR_TIPO            TIPO_EGRESO NOT NULL,
    EGR_CONCEPTO        VARCHAR(150) NOT NULL,
    EGR_CANTIDAD        NUMERIC(12,2) NOT NULL,
    EGR_PRECIO_UNIDAD   NUMERIC(12,2) NOT NULL,
    EGR_BENEFICIARIO    VARCHAR(120),
    EGR_MONTO           NUMERIC(12,2) NOT NULL,
    EGR_OBS1            TEXT,
    EGR_OBS2            TEXT,
    EGR_OBS3            TEXT,
    EGR_ESTADO          BOOLEAN NOT NULL DEFAULT TRUE,


    CONSTRAINT FK_EGR_USU
        FOREIGN KEY (USU_ID)
        REFERENCES USUARIO (USU_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT CK_EGR_MONTO CHECK (EGR_MONTO > 0),
    CONSTRAINT CK_EGR_CANTIDAD CHECK (EGR_CANTIDAD > 0),
    CONSTRAINT CK_EGR_PRECIO_UNIDAD CHECK (EGR_PRECIO_UNIDAD > 0)
);

CREATE TYPE TIPO_ACCION_AUDITORIA AS ENUM (
    'INSERT',
    'UPDATE',
    'DELETE',
    'LOGIN',
    'LOGOUT',
    'CANCELACION',
    'ANULACION',
    'CAMBIO_ESTADO',
    'OTRO'
);

CREATE TABLE AUDITORIA_SISTEMA (
    AUD_ID                  BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    USU_ID                  BIGINT,
    AUD_FEC                 TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    AUD_TABLA               VARCHAR(200) NOT NULL,
    AUD_ID_REGISTRO         VARCHAR(200) NOT NULL,
    AUD_ACCION              TIPO_ACCION_AUDITORIA NOT NULL,
    AUD_CAMPO               VARCHAR(200),
    AUD_VALOR_ANTERIOR      TEXT,
    AUD_VALOR_NUEVO         TEXT,
    AUD_DESCRIPCION         TEXT,
    AUD_IP                  VARCHAR(200),
    AUD_DISPOSITIVO         VARCHAR(200),

    CONSTRAINT FK_AUD_USU
        FOREIGN KEY (USU_ID)
        REFERENCES USUARIO (USU_ID)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);
